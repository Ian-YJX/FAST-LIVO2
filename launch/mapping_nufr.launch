<launch>
<!-- Launch file for NUFR-M3F Dataset -->
	<arg name="rviz" default="true" />
	
	<!-- Load global simu parameters customized for NUFR Dataset -->
	<rosparam command="load" file="$(find fast_livo)/config/nufr.yaml" />
	
	<!-- Note that semantic inference is skipped according to user request -->

      <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen" launch-prefix="gdb -ex run --args">
      	<rosparam file="$(find fast_livo)/config/camera_zed.yaml" />
      </node>
      
  	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
</launch>
