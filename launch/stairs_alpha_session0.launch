<launch>
<!-- Phase A: GEODE stairs_alpha (VLP-16) single-session
     FAST-LIVO2 + STD loop closure + keyframe saving
     Run: rosbag play ~/catkin_ws/bags/GEODE/stairs/stairs_alpha.bag -->

  <arg name="rviz" default="true" />

  <!-- ========== FAST-LIVO2 ========== -->
  <rosparam command="load" file="$(find fast_livo)/config/stairs_alpha.yaml" />

  <!-- STD single-session -->
  <rosparam command="load" file="$(find std_detector)/config/config_stairs_alpha.yaml" />

  <!-- Image preprocessing + semantic inference -->
  <include file="$(find fast_livo)/launch/img_preprocess_geode_alpha.launch"/>

  <!-- FAST-LIVO2 mapping -->
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_geode_alpha.yaml" />
  </node>

  <!-- STD online demo (loop closure + keyframe saving) -->
  <node pkg="std_detector" type="online_demo" name="online_demo" output="screen"/>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>

</launch>
