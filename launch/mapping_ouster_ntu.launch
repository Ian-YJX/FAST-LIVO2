<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/custom.yaml" />
	<param name="/use_sim_time" value="true"/>
	<!-- <rosparam command="load" file="$(find std_detector)/config/config_yunnan_garden.yaml" /> -->
      <include file="$(find fast_livo)/launch/img_preprocess.launch"/>

      <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
      <rosparam file="$(find fast_livo)/config/camera_realsense.yaml" />
      </node>
	  <!-- <node pkg="std_detector" type="online_demo"	name="online_demo" output="screen"/> -->
  	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
       <!-- <include file="$(find semantic_inference_ros)/launch/semantic_inference.launch"/> -->
</launch>