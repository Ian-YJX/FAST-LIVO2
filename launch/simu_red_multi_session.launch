<launch>
<!-- Simu Red Multi-Session: FAST-LIVO2 + STD online multi-session (Task 2 Step 2) -->
<!-- Prerequisites: Session0 (blue) keyframes must be saved in data_simu/blue/ -->
<!-- Semantic segmentation is included via img_preprocess.launch (default on) -->

  <arg name="rviz" default="true" />

  <!-- Load FAST-LIVO2 config for Red robot -->
  <rosparam command="load" file="$(find fast_livo)/config/simu_red.yaml" />
  <!-- Load STD config for multi-session -->
  <rosparam command="load" file="$(find std_detector)/config/config_simu_multi_session.yaml" />

  <!-- Image preprocessing + semantic inference -->
  <include file="$(find fast_livo)/launch/img_preprocess.launch"/>

  <!-- FAST-LIVO2 mapping -->
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_realsense.yaml" />
  </node>

  <!-- STD online multi-session demo (load session0 + online session1) -->
  <node pkg="std_detector" type="online_multi_session_demo"
        name="online_multi_session_demo" output="screen"/>

  <!-- RViz with multi-session visualization -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find std_detector)/rviz_cfg/online_ms.rviz" />
  </group>

</launch>
