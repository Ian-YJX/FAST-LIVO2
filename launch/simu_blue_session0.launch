<launch>
<!-- Simu Blue: FAST-LIVO2 + STD single-session (Task 1) -->
<!-- Semantic segmentation is included via img_preprocess.launch (default on) -->

  <arg name="rviz" default="true" />

  <!-- Load FAST-LIVO2 config for Blue robot -->
  <rosparam command="load" file="$(find fast_livo)/config/simu_blue.yaml" />
  <!-- Load STD config for single-session blue -->
  <rosparam command="load" file="$(find std_detector)/config/config_simu_blue.yaml" />

  <!-- Image preprocessing + semantic inference -->
  <include file="$(find fast_livo)/launch/img_preprocess.launch"/>

  <!-- FAST-LIVO2 mapping -->
  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_realsense.yaml" />
  </node>

  <!-- STD online single-session demo (loop closure + keyframe saving) -->
  <node pkg="std_detector" type="online_demo" name="online_demo" output="screen"/>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>

</launch>
